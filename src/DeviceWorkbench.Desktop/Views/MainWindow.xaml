<Window x:Class="DeviceWorkbench.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DeviceWorkbench.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="{Binding Title}"
        Style="{StaticResource WindowShellStyle}"
        Width="1180" Height="780" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="156" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <Border DockPanel.Dock="Right" Background="#E7ECF3" CornerRadius="12"
                    Padding="14,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding ConnectionStatus}" />
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="영상 수집 및 검사" Margin="0,5,0,0" Foreground="#637087" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="장비 및 작업" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="장비" Margin="0,0,0,8" />
                    <TextBlock Text="선택된 장비가 없습니다." Foreground="#637087"
                               TextWrapping="Wrap" Margin="0,0,0,24" />
                    <Label Content="작업명" Target="{Binding ElementName=WorkNameInput}"
                           Padding="0" Margin="0,0,0,8" />
                    <TextBox x:Name="WorkNameInput" Padding="8" MaxLength="100"
                             AutomationProperties.Name="작업명"
                             Text="{Binding WorkName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="영상" Style="{StaticResource PanelTitle}" />
                    <Border Grid.Row="1" Background="#F4F6F9" CornerRadius="4">
                        <TextBlock Text="영상 수신 대기" Foreground="#637087"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="검사 결과" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="아직 검사 결과가 없습니다." Foreground="#637087"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="로그 지우기" Padding="12,4"
                            Command="{Binding ClearLogCommand}" />
                    <TextBlock Text="활동 로그" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLog}" BorderThickness="0"
                         Background="Transparent" AutomationProperties.Name="활동 로그"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Grid>
        </Border>
    </Grid>
</Window>
